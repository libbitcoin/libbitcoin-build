.template 0
###############################################################################
# Copyright (c) 2014-2026 libbitcoin developers (see COPYING).
#
# GSL generate libbitcoin double-build.yml.
#
# This is a code generator built using the iMatix GSL code generation
# language. See https://github.com/imatix/gsl for details.
###############################################################################

# Note: expected context root libbitcoin-build/process directory
[gsl].ignorecase = 0

gsl from "../templates/yml/base_ci_workflow.yml.gsl"

###############################################################################
# Generation
###############################################################################
function generate_double_build_yml(configuration)
    define my.configuration = generate_double_build_yml.configuration
    define my.filename = "double-build.yml"
    require(my.configuration->templates, "templates", "resultpath")

    define my.template = my.configuration->templates->template(.name = "$(my.filename).gsl")

    if (!defined(my.template))
        abort "Generator configuration missing."
    endif

    require(my.template, "template", "outpath")
    define my.project_path_suffix = my.template.outpath

    for my.configuration.repository by .name as _repository
        require(_repository, "repository", "name")
        define my.output_path = path_append(\
            my.configuration->templates.resultpath, \
            path_append(my.path_prefix, \
                path_append(_repository.name, my.project_path_suffix)))

        if (count_release_jobs(_repository) > 0)
            create_directory(my.output_path)

            define my.out_file = path_append(my.output_path, my.filename)
            notify(my.out_file)
            output(my.out_file)

            emit_double_build_yml(my.template, my.configuration, _repository)

            close
        endif
    endfor _repository
endfunction

###############################################################################
# Functions
###############################################################################
function release_basenames(repository)
    define my.repository = release_basenames.repository
    define my.result = ""

    for my.repository->ci.entry as _entry
        for _entry.job as _job where is_defined_positive(_job, "release")
            if (my.result = "")
                my.result = _job.basename
            else
                my.result = "$(my.result) $(_job.basename)"
            endif
        endfor
    endfor

    return my.result
endfunction

function count_hosted_release_jobs(repository, hosted)
    define my.repository = count_hosted_release_jobs.repository
    define my.hosted = count_hosted_release_jobs.hosted
    define my.count = 0

    for my.repository->ci.entry as _entry
        for _entry.job as _job where is_defined_positive(_job, "release") & \
          (defined(_job.host) = my.hosted)
            my.count += 1
        endfor
    endfor

    return my.count
endfunction

function release_hosts(repository)
    define my.repository = release_hosts.repository
    define my.result = ""

    for my.repository->ci.entry as _entry
        for _entry.job as _job where is_defined_positive(_job, "release") & \
          defined(_job.host)
            if !is_token(" \"$(_job.host)\"", " $(my.result)")
                my.result = join(my.result, "\"$(_job.host)\"", ", ")
            endif
        endfor
    endfor

    return my.result
endfunction

###############################################################################
# Macros
###############################################################################
.endtemplate
.template 1
.
.macro emit_double_build_yml(meta, configuration, repository)
.   define my.meta = emit_double_build_yml.meta
.   define my.configuration = emit_double_build_yml.configuration
.   define my.repository = emit_double_build_yml.repository
.
.   copyleft(my.repository.name)

name: Double Build

on:
  workflow_dispatch:
    inputs:
      ref:
        description: "Branch or tag of all five repositories (default: this branch)."
        required: false
        default: ''
        type: string
  workflow_call:
    inputs:
      tag-database:
        type: string
        required: true
      tag-network:
        type: string
        required: true
      tag-node:
        type: string
        required: true
      tag-server:
        type: string
        required: true
      tag-system:
        type: string
        required: true

permissions:
  contents: read

jobs:

  resolve:
    runs-on: ubuntu-24.04

    outputs:
      system: ${{ steps.resolve.outputs.system }}
      database: ${{ steps.resolve.outputs.database }}
      network: ${{ steps.resolve.outputs.network }}
      node: ${{ steps.resolve.outputs.node }}
      server: ${{ steps.resolve.outputs.server }}

    steps:
      - name: Resolve commits
        id: resolve
        shell: bash
        env:
          OWNER: ${{ github.repository_owner }}
          DEFAULT: ${{ inputs.ref || github.ref_name }}
          REF_system: ${{ inputs.tag-system }}
          REF_database: ${{ inputs.tag-database }}
          REF_network: ${{ inputs.tag-network }}
          REF_node: ${{ inputs.tag-node }}
          REF_server: ${{ inputs.tag-server }}
        run: |
          for REPO in system database network node server; do
            NAME="REF_${REPO}"
            REF="${!NAME:-${DEFAULT}}"
            REFS=\$(git ls-remote "https://github.com/${OWNER}/libbitcoin-${REPO}" \\
              "refs/heads/${REF}" "refs/tags/${REF}" "refs/tags/${REF}^{}")
            SHA=\$(echo "${REFS}" | awk '/\\^\\{\\}$/ { print $1 }')
            SHA=${SHA:-\$(echo "${REFS}" | awk 'NR == 1 { print $1 }')}
            if [[ -z "${SHA}" ]]; then
              echo "libbitcoin-${REPO} has no branch or tag '${REF}'."
              exit 1
            fi
            echo "libbitcoin-${REPO} ${REF} ${SHA}" | tee -a "$GITHUB_STEP_SUMMARY"
            echo "${REPO}=${SHA}" >> "$GITHUB_OUTPUT"
          done
.   if count_hosted_release_jobs(my.repository, 0) > 0

  build:
    needs: resolve

    strategy:
      fail-fast: false

      matrix:
        builder:
          - name: "a"
            root: "."
            timezone: "UTC"
            umask: "0022"
          - name: "b"
            root: "builder-b"
            timezone: "Pacific/Auckland"
            umask: "0002"

        target:
.   define my.first = 1
.   for my.repository->ci.entry as _entry
.       for _entry.job as _job where is_defined_positive(_job, "release") & !defined(_job.host)
.           if !my.first

.           endif
.           my.first = 0
.           define my.options = accumulate_options(_entry, _job)
.           define my.cc = compiler(_job, _entry, "c")
.           define my.cxx = compiler(_job, _entry, "cxx")
.           define my.flags = flags(_job, _entry)
.           define my.linkflags = element_property_concat("linkflag", "value", _entry)
          - basename: "$(_job.basename)"
.           if defined(_job.project)
            project: "$(_job.project)"
.           endif
.           if defined(_job.program)
            program: "$(_job.program)"
.           endif
            configuration: $(property_priority("configuration", _job, _entry, property_priority("config", _job, _entry)))
.           if defined(_job.link)
            link: $(_job.link)
.           endif
            toolchain: $((_job.name = "msvc") ?? "msbuild" ? _job.name)
.           if !(my.options = "")
.               if (left(my.options, 1) = "\"")
            options: '$(my.options)'
.               else
            options: "$(my.options)"
.               endif
.           endif
.           if !(my.cc = "")
            cc: "$(my.cc)"
.           endif
.           if !(my.cxx = "")
            cxx: "$(my.cxx)"
.           endif
.           if !(my.linkflags = "")
            linkflags: "$(my.linkflags)"
.           endif
.           if defined(_entry.platform)
            platform: "$(_entry.platform)"
.           endif
.           if defined(_entry.toolset)
            toolset: "$(_entry.toolset)"
.           endif
.           if defined(_entry.version)
            version: "$(_entry.version)"
.           endif
            image: $(_entry.image)
.           if defined(_entry.container)
            container: $(_entry.container)
.           endif
.           if defined(_entry.deployment_target)
            deployment_target: "$(_entry.deployment_target)"
.           endif
.           if !(my.flags = "")
            flags: "$(my.flags)"
.           endif
.       endfor
.   endfor


    runs-on: ${{ matrix.target.image }}
    container: ${{ matrix.target.container || null }}

    env:
      CC: ${{ matrix.target.cc }}
      CXX: ${{ matrix.target.cxx }}
      TZ: ${{ matrix.builder.timezone }}

    steps:
      - name: Checkout libbitcoin-server
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          path: "${{ matrix.builder.root }}/libbitcoin-server"
          ref: ${{ needs.resolve.outputs.server }}
          repository: ${{ github.repository_owner }}/libbitcoin-server

      - name: Checkout libbitcoin-node
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          path: "${{ matrix.builder.root }}/libbitcoin-node"
          ref: ${{ needs.resolve.outputs.node }}
          repository: ${{ github.repository_owner }}/libbitcoin-node

      - name: Checkout libbitcoin-network
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          path: "${{ matrix.builder.root }}/libbitcoin-network"
          ref: ${{ needs.resolve.outputs.network }}
          repository: ${{ github.repository_owner }}/libbitcoin-network

      - name: Checkout libbitcoin-database
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          path: "${{ matrix.builder.root }}/libbitcoin-database"
          ref: ${{ needs.resolve.outputs.database }}
          repository: ${{ github.repository_owner }}/libbitcoin-database

      - name: Checkout libbitcoin-system
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          path: "${{ matrix.builder.root }}/libbitcoin-system"
          ref: ${{ needs.resolve.outputs.system }}
          repository: ${{ github.repository_owner }}/libbitcoin-system

      - name: Checkout build definition
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          path: ".definition"
          ref: ${{ needs.resolve.outputs.server }}
          repository: ${{ github.repository_owner }}/libbitcoin-server
          sparse-checkout: .github/actions

      - name: Apply umask
        if: ${{ !matrix.target.container }}
        shell: bash
        run: |
          echo "umask ${{ matrix.builder.umask }}" > "${RUNNER_TEMP}/umask.sh"
          echo "BASH_ENV=${RUNNER_TEMP}/umask.sh" >> "$GITHUB_ENV"

      - name: Apply umask [container]
        if: ${{ matrix.target.container }}
        shell: sh
        run: |
          echo "umask ${{ matrix.builder.umask }}" > "${RUNNER_TEMP}/umask.sh"
          echo "BASH_ENV=${RUNNER_TEMP}/umask.sh" >> "$GITHUB_ENV"

      - name: Build
        id: binary
        uses: ./.definition/.github/actions/build-binary
        with:
          root: ${{ matrix.builder.root }}
          toolchain: ${{ matrix.target.toolchain }}
          basename: ${{ matrix.target.basename }}
          project: ${{ matrix.target.project || 'libbitcoin-server' }}
          program: ${{ matrix.target.program || 'bs' }}
          configuration: ${{ matrix.target.configuration }}
          link: ${{ matrix.target.link }}
          preset: ${{ matrix.target.preset }}
          options: ${{ matrix.target.options }}
          flags: ${{ matrix.target.flags }}
          linkflags: ${{ matrix.target.linkflags }}
          packages: ${{ matrix.target.packages }}
          llvm: ${{ matrix.target.llvm }}
          deployment_target: ${{ matrix.target.deployment_target }}
          platform: ${{ matrix.target.platform }}
          toolset: ${{ matrix.target.toolset }}
          version: ${{ matrix.target.version }}
          container: ${{ matrix.target.container }}

      - name: Display candidate files
        working-directory: candidate
        shell: bash
        run: |
          ls -lahR

      - name: Display binary information [bash]
        if: ${{ matrix.target.toolchain != 'msbuild' }}
        continue-on-error: true
        shell: bash
        working-directory: candidate
        run: |
          ./${{ steps.binary.outputs.candidate_identifier }} --version
          ./${{ steps.binary.outputs.candidate_identifier }} --hardware

      - name: Display binary information [cmd]
        if: ${{ matrix.target.toolchain == 'msbuild' }}
        continue-on-error: true
        shell: cmd
        working-directory: candidate
        run: |
          .\\${{ steps.binary.outputs.candidate_identifier }} --version
          .\\${{ steps.binary.outputs.candidate_identifier }} --hardware

      - name: Display linkage
        if: ${{ matrix.target.toolchain != 'msbuild' }}
        shell: bash
        run: |
          echo "Binary linkage information:"
          find candidate -type f \\
            \\( -perm -111 -o -name "*.so" -o -name "*.dylib" \\) \\
            ! -path "*/.git/*" \\
            ! -name "*.a" \\
            -print0 | while IFS= read -r -d '' f; do
              if ! file "$f" | grep -qE "ELF|Mach-O|PE32"; then
                continue
              fi
              echo "========================================"
              echo "File: $f"
              file "$f"
              case "\$(uname -s)" in
                Linux)
                  ldd "$f"
                  if ldd "$f" 2>/dev/null | grep -q .; then
                    echo "--- Dynamic dependencies (ldd) ---"
                    ldd "$f" || true
                  else
                    echo "--- No dynamic dependencies (likely fully static) ---"
                    ldd "$f" 2>&1 || true
                  fi
                  echo "--- ELF dynamic section (readelf -d) ---"
                  readelf -d "$f" 2>/dev/null | grep -E 'NEEDED|RPATH|RUNPATH|SONAME' || echo "(none)"
                  ;;
                Darwin)
                  otool -L "$f"
                  echo "--- Linked libraries (otool -L) ---"
                  otool -L "$f" || true
                  ;;
                *)
                  echo "Unsupported platform for linkage display: \$(uname -s)"
                  ;;
              esac
            done || true

      - name: Record build
        shell: bash
        run: |
          mkdir output
          cp candidate/* symbols/* output/
          {
            echo "image: ${ImageOS} ${ImageVersion}"
            if [[ -n "${CXX}" ]]; then echo "compiler: \$(${CXX} --version | head -1)"; fi
            echo "source: ${BUILD_SOURCE}"
            echo "timezone: ${TZ}"
            echo "umask: \$(umask)"
          } | tee output/toolchain.txt
          cd output
          FILES=\$(ls | grep -v -x toolchain.txt)
          if command -v sha256sum > /dev/null; then
            sha256sum ${FILES}
          else
            shasum -a 256 ${FILES}
          fi | sed 's/ [*]/  /' | tee SHA256SUMS

      - name: Upload build
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: double-${{ matrix.target.basename }}-${{ matrix.builder.name }}
          path: output
          retention-days: 7

      - name: Upload artifacts
        if: ${{ matrix.builder.name == 'a' }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: ${{ steps.binary.outputs.candidate_identifier }}
          path: candidate/*
          retention-days: 1
          if-no-files-found: error

      - name: Upload symbols
        if: ${{ matrix.builder.name == 'a' && (matrix.target.configuration != 'debug' || matrix.target.toolchain == 'msbuild') }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: symbols-${{ matrix.target.basename }}
          path: symbols/*
          retention-days: 1
          if-no-files-found: error
.   endif
.   if count_hosted_release_jobs(my.repository, 1) > 0
.       emit_guix_jobs(my.repository)
.   endif
.   define my.native = (count_hosted_release_jobs(my.repository, 0) > 0) ?? "build" ? ""
.   define my.hosted = (count_hosted_release_jobs(my.repository, 1) > 0) ?? "guix" ? ""

  compare:
    needs: [ $(join(my.native, my.hosted, ", ")) ]
    if: ${{ !cancelled() }}
    runs-on: ubuntu-24.04

    steps:
      - name: Download builds
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          pattern: double-*

      - name: Compare hashes
        id: compare
        shell: bash
        run: |
          echo "| file | builder a | builder b |" >> "$GITHUB_STEP_SUMMARY"
          echo "| --- | --- | --- |" >> "$GITHUB_STEP_SUMMARY"
          DIFFER=""
          MISSING=""
          for NAME in $(release_basenames(my.repository)); do
            A="double-${NAME}-a"
            B="double-${NAME}-b"
            if [[ ! -f "${A}/SHA256SUMS" || ! -f "${B}/SHA256SUMS" ]]; then
              MISSING="${MISSING} ${NAME}"
              continue
            fi
            join -j 2 <(sort -k2 "${A}/SHA256SUMS") <(sort -k2 "${B}/SHA256SUMS") |
              awk '{ print "| " $1 " | " substr($2, 1, 16) " | " substr($3, 1, 16) " |" }' >> "$GITHUB_STEP_SUMMARY"
            if ! cmp -s <(grep -v '[.]pdb[.]zip$' "${A}/SHA256SUMS") <(grep -v '[.]pdb[.]zip$' "${B}/SHA256SUMS"); then
              DIFFER="${DIFFER} double-${NAME}"
            fi
          done
          echo "PDB files are not compared: link.exe does not write them deterministically." | tee -a "$GITHUB_STEP_SUMMARY"
          if [[ -n "${MISSING}" ]]; then
            echo "Builds missing:${MISSING}" | tee -a "$GITHUB_STEP_SUMMARY"
            echo "missing=${MISSING}" >> "$GITHUB_OUTPUT"
          fi
          if [[ -n "${DIFFER}" ]]; then
            echo "Builds differ:${DIFFER}" | tee -a "$GITHUB_STEP_SUMMARY"
            echo "differ=${DIFFER}" >> "$GITHUB_OUTPUT"
          elif [[ -z "${MISSING}" ]]; then
            echo "Builds are identical." | tee -a "$GITHUB_STEP_SUMMARY"
          fi

      - name: Explain differences
        if: ${{ steps.compare.outputs.differ != '' }}
        shell: bash
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends diffoscope-minimal binutils
          mkdir report
          for PAIR in ${{ steps.compare.outputs.differ }}; do
            for FILE in \$(cut -d' ' -f3 "${PAIR}-a/SHA256SUMS"); do
              diffoscope --max-report-size 50000000 \\
                --text "report/${FILE}.txt" --html "report/${FILE}.html" \\
                "${PAIR}-a/${FILE}" "${PAIR}-b/${FILE}" || true
            done
          done
          head -c 20000 report/*.txt

      - name: Upload report
        if: ${{ steps.compare.outputs.differ != '' }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: diffoscope
          path: report
          retention-days: 7

      - name: Fail on difference
        if: ${{ steps.compare.outputs.differ != '' || steps.compare.outputs.missing != '' }}
        shell: bash
        run: exit 1
.endmacro # emit_double_build_yml
.
.macro emit_checkout(repository, root)
.   define my.repository = emit_checkout.repository
.   define my.root = emit_checkout.root
      - name: Checkout $(my.repository)
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          path: "$(my.root)/$(my.repository)"
          ref: ${{ needs.resolve.outputs.$(string.replace(my.repository, "libbitcoin-|")) }}
          repository: ${{ github.repository_owner }}/$(my.repository)

.endmacro # emit_checkout
.
.macro emit_guix_jobs(repository)
.   define my.repository = emit_guix_jobs.repository

  toolchain:
    needs: resolve

    strategy:
      fail-fast: false

      matrix:
        runner: [ "ubuntu-24.04", "ubuntu-24.04-arm" ]
        host: [ $(release_hosts(my.repository)) ]

    runs-on: ${{ matrix.runner }}
    timeout-minutes: 360

    steps:
      - name: Checkout build definition
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          path: ".definition"
          ref: ${{ needs.resolve.outputs.server }}
          repository: ${{ github.repository_owner }}/libbitcoin-server
          sparse-checkout: |
            .github/actions
            .github/guix

      - name: Find toolchain
        id: find
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: guix-cache
          key: guix-${{ runner.arch }}-${{ matrix.host }}-${{ hashFiles('.definition/.github/guix/*.scm', '.definition/.github/guix/patches/*') }}
          lookup-only: true

      - name: Setup Guix
        if: ${{ steps.find.outputs.cache-hit != 'true' }}
        uses: ./.definition/.github/actions/setup-guix

      - name: Build toolchain
        if: ${{ steps.find.outputs.cache-hit != 'true' }}
        shell: bash
        env:
          HOST: ${{ matrix.host }}
        run: |
          GUIX_DIR="\$(realpath .definition/.github/guix)"
          ENVIRONMENT=\$(guix time-machine --channels="${GUIX_DIR}/channels.scm" -- \\
            shell --no-grafts --load-path="${GUIX_DIR}" --manifest="${GUIX_DIR}/manifest.scm" -- \\
            printenv GUIX_ENVIRONMENT)
          INFERIOR=\$(find "/var/guix/profiles/per-user/${USER}/inferiors" -type l | head -1)
          mkdir guix-cache
          basename "${INFERIOR}" > guix-cache/inferior-key
          readlink -f "${INFERIOR}" > guix-cache/inferior
          sudo guix archive --generate-key
          cp /etc/guix/signing-key.pub guix-cache/
          guix archive --export -r "\$(cat guix-cache/inferior)" "${ENVIRONMENT}" |
            zstd -T0 -12 -o guix-cache/store.nar.zst
          ls -la guix-cache

      - name: Display build logs
        if: ${{ failure() }}
        shell: bash
        run: |
          sudo find /var/log/guix/drvs -type f -mmin -60 -printf '%T@ %p\\n' |
            sort -rn | head -5 | while read -r _ LOG; do
              echo "== ${LOG}"
              zcat -f "${LOG}" | tail -60
            done

      - name: Save toolchain
        if: ${{ steps.find.outputs.cache-hit != 'true' }}
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: guix-cache
          key: ${{ steps.find.outputs.cache-primary-key }}

  guix:
    needs: [ resolve, toolchain ]

    strategy:
      fail-fast: false

      matrix:
        builder:
          - name: "a"
            image: "ubuntu-24.04"
          - name: "b"
            image: "ubuntu-24.04-arm"

        target:
.   define my.first = 1
.   for my.repository->ci.entry as _entry
.       for _entry.job as _job where is_defined_positive(_job, "release") & defined(_job.host)
.           if !my.first

.           endif
.           my.first = 0
.           define my.options = accumulate_options(_entry, _job)
.           define my.flags = flags(_job, _entry)
.           define my.linkflags = element_property_concat("linkflag", "value", _entry)
          - basename: "$(_job.basename)"
            host: "$(_job.host)"
.           if defined(_job.project)
            project: "$(_job.project)"
.           endif
.           if defined(_job.program)
            program: "$(_job.program)"
.           endif
.           if !(my.options = "")
.               if (left(my.options, 1) = "\"")
            options: '$(my.options)'
.               else
            options: "$(my.options)"
.               endif
.           endif
.           if !(my.linkflags = "")
            linkflags: "$(my.linkflags)"
.           endif
.           if !(my.flags = "")
            flags: "$(my.flags)"
.           endif
.       endfor
.   endfor


    runs-on: ${{ matrix.builder.image }}

    steps:
.   emit_checkout("libbitcoin-server", "src")
.   emit_checkout("libbitcoin-node", "src")
.   emit_checkout("libbitcoin-network", "src")
.   emit_checkout("libbitcoin-database", "src")
.   emit_checkout("libbitcoin-system", "src")
      - name: Checkout build definition
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          path: ".definition"
          ref: ${{ needs.resolve.outputs.server }}
          repository: ${{ github.repository_owner }}/libbitcoin-server
          sparse-checkout: |
            .github/actions
            .github/guix

      - name: Restore toolchain
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: guix-cache
          key: guix-${{ runner.arch }}-${{ matrix.target.host }}-${{ hashFiles('.definition/.github/guix/*.scm', '.definition/.github/guix/patches/*') }}
          fail-on-cache-miss: true

      - name: Setup Guix
        uses: ./.definition/.github/actions/setup-guix
        with:
          cache: guix-cache

      - name: Build
        shell: bash
        env:
          HOST: ${{ matrix.target.host }}
          BASENAME: ${{ matrix.target.basename }}
          PROJECT: ${{ matrix.target.project }}
          PROGRAM: ${{ matrix.target.program }}
          FLAGS: ${{ matrix.target.flags }}
          LINKFLAGS: ${{ matrix.target.linkflags }}
          OPTIONS: ${{ matrix.target.options }}
        run: |
          bash .definition/.github/guix/guix-build.sh src build
          mkdir candidate symbols
          cp "build/${BASENAME}" candidate/
          cp "build/${BASENAME}.debug" symbols/

      - name: Display binary information
        if: ${{ (runner.arch == 'X64' && startsWith(matrix.target.host, 'x86_64-')) || (runner.arch == 'ARM64' && startsWith(matrix.target.host, 'aarch64-')) }}
        continue-on-error: true
        shell: bash
        working-directory: candidate
        run: |
          ./${{ matrix.target.basename }} --version
          ./${{ matrix.target.basename }} --hardware

      - name: Display linkage
        shell: bash
        working-directory: candidate
        run: |
          file ${{ matrix.target.basename }}
          readelf -d ${{ matrix.target.basename }} | grep -E 'NEEDED|RPATH|RUNPATH|SONAME' || echo "(none)"
          readelf -V --wide ${{ matrix.target.basename }} | grep -o 'GLIBC_[0-9.]*' | sort -uV | tail -1

      - name: Record build
        shell: bash
        run: |
          mkdir output
          cp candidate/* symbols/* output/
          {
            echo "image: ${ImageOS} ${ImageVersion} ${RUNNER_ARCH}"
            echo "guix: \$(grep -o 'commit "[0-9a-f]*"' .definition/.github/guix/channels.scm)"
            echo "host: ${{ matrix.target.host }}"
          } | tee output/toolchain.txt
          cd output
          FILES=\$(ls | grep -v -x toolchain.txt)
          sha256sum ${FILES} | tee SHA256SUMS

      - name: Upload build
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: double-${{ matrix.target.basename }}-${{ matrix.builder.name }}
          path: output
          retention-days: 7

      - name: Upload artifacts
        if: ${{ matrix.builder.name == 'a' }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: ${{ matrix.target.basename }}
          path: candidate/*
          retention-days: 1
          if-no-files-found: error

      - name: Upload symbols
        if: ${{ matrix.builder.name == 'a' }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: symbols-${{ matrix.target.basename }}
          path: symbols/*
          retention-days: 1
          if-no-files-found: error
.endmacro # emit_guix_jobs
.
.endtemplate
.template 0
###############################################################################
# Execution
###############################################################################

generate_double_build_yml(configuration)

.endtemplate
